# Copiar a .env (o correr scripts/gen-keys.sh, que lo genera). NUNCA commitear .env.
# Ojo: stellar CLI lee el .env del directorio actual. No usar STELLAR_NETWORK ni
# STELLAR_RPC_URL aca: chocan con el CLI (pide network passphrase y falla).
X402_NETWORK=stellar:testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Cuentas (scripts/gen-keys.sh). *_SECRET son S... de testnet.

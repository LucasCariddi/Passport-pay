{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.mjs": { "maxDuration": 60, "memory": 1024, "includeFiles": "deploy/**", "excludeFiles": "{.env,.env.*,.secrets/**,**/.env,**/.env.*}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/catalog", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path((?!assets/|zk/).*)", "destination": "/app/index.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/app/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
